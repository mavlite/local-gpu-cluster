[Unit]
Description=Allowlisting HTTP proxy for the GamePilot conductor (CT 160), port 3129
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=tinyproxy-gamepilot
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/install -d -o tinyproxy -g tinyproxy /run/tinyproxy-gamepilot
ExecStart=/usr/bin/tinyproxy -d -c /etc/tinyproxy/gamepilot.conf
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
