 // compressionSystemPrompt is the §4 body prompt.
 const compressionSystemPrompt = `你在压缩一组【彼此关联】的探索节点，产出一段综合结论(body)，供规划者快速掌握"这一片已经探明了什么"。
 
diff --git a/agent/compaction_lang_test.go b/agent/compaction_lang_test.go
new file mode 100644
index 0000000..17e0dbc
--- /dev/null
+++ b/agent/compaction_lang_test.go
@@ -0,0 +1,25 @@
+package agent
+
+import (
+	"strings"
+	"testing"
+)
+
+// The compactor builds its llm.CompletionRequest by hand rather than going through
+// renderSystem, so the output-language directive has to be appended explicitly. It
+// was not, and digests came back in the prompt body's own language (Chinese)
+// whatever display language was configured. langMarker lives in prompt_test.go.
+func TestCompressionSystemCarriesOutputLanguage(t *testing.T) {
+	t.Cleanup(func() { OutputLanguage = nil })
+	for _, code := range SupportedOutputLangs {
+		code := code
+		OutputLanguage = func() string { return code }
+		got := compressionSystem()
+		if !strings.HasPrefix(got, compressionSystemPrompt) {
+			t.Fatalf("%s: compressionSystem must keep the §4 body prompt intact", code)
+		}
+		if !strings.Contains(got, langMarker[code]) {
+			t.Fatalf("%s: compressionSystem must name the display language (%q); without it digests stay in the prompt's own language", code, langMarker[code])
+		}
+	}
+}
