diff --git a/agent/repeatguard.go b/agent/repeatguard.go
new file mode 100644
index 0000000..5c4c70c
--- /dev/null
+++ b/agent/repeatguard.go
@@ -0,0 +1,126 @@
+package agent
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"log"
+	"sync"
+
+	actool "github.com/Autumn-27/norma/tool"
+)
+
+const (
+	// repeatGuardLimit is how many times one identical call may return one
+	// identical result within the window before further repeats are refused.
+	repeatGuardLimit = 3
+	// repeatGuardWindow is how many recent executed calls the guard remembers.
+	repeatGuardWindow = 8
+)
+
+// repeatGuard stops an agent from re-issuing identical tool calls forever —
+// both a straight run (A A A A …) and a cycle (A B A B …). A model that gets an
+// uninformative result can copy its own previous calls from the history turn
+// after turn; sampling penalties only act within one completion, so they cannot
+// break a loop that spans turns. Observed 2026-11-10: the planner called
+// list_assets with one DSL 300 times, then alternated two variants.
+//
+// The guard keys on tool name + canonical arguments AND on the result: a call is
+// refused when the same call has returned the same result repeatGuardLimit times
+// within the last repeatGuardWindow executed calls. A polling call whose output
+// changes is never refused, and a call becomes allowed again once enough other
+// calls push its earlier repeats out of the window. Refused calls are not
+// recorded. One guard is shared by all tools of one agent run.
+type repeatGuard struct {
+	mu      sync.Mutex
+	limit   int
+	window  int
+	history []repeatEntry // most recent last, at most window entries
+}
+
+type repeatEntry struct{ key, result string }
+
+func newRepeatGuard(limit, window int) *repeatGuard {
+	return &repeatGuard{limit: limit, window: window}
+}
+
+func (g *repeatGuard) wrap(t actool.CoreTool) actool.CoreTool {
+	return &repeatGuardedTool{CoreTool: t, guard: g}
+}
+
+// refuse reports whether a call with key must be refused, and how many times
+// its latest result occurs in the window.
+func (g *repeatGuard) refuse(key string) (bool, int) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	latest, found := "", false
+	for i := len(g.history) - 1; i >= 0; i-- {
+		if g.history[i].key == key {
+			latest, found = g.history[i].result, true
+			break
+		}
+	}
+	if !found {
+		return false, 0
+	}
+	n := 0
+	for _, e := range g.history {
+		if e.key == key && e.result == latest {
+			n++
+		}
+	}
+	return n >= g.limit, n
+}
+
+func (g *repeatGuard) record(key, result string) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.history = append(g.history, repeatEntry{key: key, result: result})
+	if over := len(g.history) - g.window; over > 0 {
+		g.history = append([]repeatEntry(nil), g.history[over:]...)
+	}
+}
+
+// repeatCallKey canonicalises the JSON input (object keys sorted by re-marshal)
+// so argument order does not hide a repeat.
+func repeatCallKey(name string, in json.RawMessage) string {
+	var v any
+	if err := json.Unmarshal(in, &v); err == nil {
+		if b, err := json.Marshal(v); err == nil {
+			return name + "\x00" + string(b)
+		}
+	}
+	return name + "\x00" + string(in)
+}
+
+func repeatResultKey(res actool.Result, err error) string {
+	h := sha256.New()
+	fmt.Fprintf(h, "%t\x00%s\x00", res.IsError, res.Flatten())
+	if err != nil {
+		h.Write([]byte(err.Error()))
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+type repeatGuardedTool struct {
+	actool.CoreTool
+	guard *repeatGuard
+}
+
+func (r *repeatGuardedTool) Call(ctx context.Context, in json.RawMessage, tc *actool.ToolContext) (actool.Result, error) {
+	key := repeatCallKey(r.Name(), in)
+	if refused, n := r.guard.refuse(key); refused {
+		log.Printf("[tools] repeat guard: refused %s (same call+result %d times in the last %d calls)", r.Name(), n, r.guard.window)
+		return actool.Errorf(fmt.Sprintf(
+			"Repeated call refused: %s was already called %d times recently with identical arguments and "+
+				"returned an identical result each time, so calling it again cannot produce new information. "+
+				"Do not repeat it, and do not cycle between the same few calls. Use the results you already "+
+				"have and take the next step (for planning: submit work with add_intent; otherwise a different "+
+				"tool, different arguments, or conclude this step).", r.Name(), n)), nil
+	}
+	res, err := r.CoreTool.Call(ctx, in, tc)
+	r.guard.record(key, repeatResultKey(res, err))
+	return res, err
+}
diff --git a/agent/repeatguard_test.go b/agent/repeatguard_test.go
new file mode 100644
index 0000000..317df1c
--- /dev/null
+++ b/agent/repeatguard_test.go
@@ -0,0 +1,145 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	actool "github.com/Autumn-27/norma/tool"
+)
+
+// fakeTool counts executions; out returns the result text for each call.
+type fakeTool struct {
+	actool.CoreTool // nil: only Name and Call are used
+	name            string
+	calls           int
+	out             func(n int) string
+}
+
+func (f *fakeTool) Name() string { return f.name }
+
+func (f *fakeTool) Call(_ context.Context, _ json.RawMessage, _ *actool.ToolContext) (actool.Result, error) {
+	f.calls++
+	return actool.Text(f.out(f.calls)), nil
+}
+
+func constOut() func(int) string { return func(int) string { return `{"assets":null,"count":0}` } }
+
+func newGuard() *repeatGuard { return newRepeatGuard(repeatGuardLimit, repeatGuardWindow) }
+
+func call(t *testing.T, tool actool.CoreTool, in string) actool.Result {
+	t.Helper()
+	res, err := tool.Call(context.Background(), json.RawMessage(in), nil)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	return res
+}
+
+func TestRepeatGuardRefusesAfterLimitIdenticalCallsAndResults(t *testing.T) {
+	ft := &fakeTool{name: "list_assets", out: constOut()}
+	tool := newGuard().wrap(ft)
+	in := `{"dsl":"ip==38.107.232.51","limit":50}`
+	for i := 1; i <= repeatGuardLimit; i++ {
+		if res := call(t, tool, in); res.IsError {
+			t.Fatalf("call %d refused, want executed", i)
+		}
+	}
+	for i := 0; i < 5; i++ {
+		if !call(t, tool, in).IsError {
+			t.Fatalf("repeat %d executed, want refused", i)
+		}
+	}
+	if ft.calls != repeatGuardLimit {
+		t.Fatalf("tool executed %d times, want %d", ft.calls, repeatGuardLimit)
+	}
+}
+
+// The 2026-11-10 second loop: two variants alternated (service/endpoint).
+func TestRepeatGuardRefusesAlternatingCycle(t *testing.T) {
+	ft := &fakeTool{name: "list_assets", out: constOut()}
+	tool := newGuard().wrap(ft)
+	a, b := `{"type":"service"}`, `{"type":"endpoint"}`
+	for i := 0; i < repeatGuardLimit; i++ {
+		if call(t, tool, a).IsError || call(t, tool, b).IsError {
+			t.Fatalf("cycle round %d refused too early", i+1)
+		}
+	}
+	if !call(t, tool, a).IsError || !call(t, tool, b).IsError {
+		t.Fatal("A/B cycle continued past the limit, want both refused")
+	}
+	if ft.calls != 2*repeatGuardLimit {
+		t.Fatalf("tool executed %d times, want %d", ft.calls, 2*repeatGuardLimit)
+	}
+}
+
+func TestRepeatGuardAllowsAgainAfterWindowMovesOn(t *testing.T) {
+	ft := &fakeTool{name: "list_assets", out: constOut()}
+	tool := newGuard().wrap(ft)
+	a := `{"dsl":"ip==1.1.1.1"}`
+	for i := 0; i < repeatGuardLimit; i++ {
+		call(t, tool, a)
+	}
+	if !call(t, tool, a).IsError {
+		t.Fatal("4th identical call executed, want refused")
+	}
+	for i := 0; i < repeatGuardWindow; i++ { // distinct calls push A out of the window
+		if call(t, tool, fmt.Sprintf(`{"dsl":"ip==10.0.0.%d"}`, i)).IsError {
+			t.Fatalf("distinct call %d refused", i)
+		}
+	}
+	if call(t, tool, a).IsError {
+		t.Fatal("call refused after its repeats left the window, want executed")
+	}
+}
+
+func TestRepeatGuardAllowsPollingWithChangingResult(t *testing.T) {
+	ft := &fakeTool{name: "Bash", out: func(n int) string { return fmt.Sprintf("progress %d%%", n*10) }}
+	tool := newGuard().wrap(ft)
+	for i := 1; i <= 10; i++ {
+		if call(t, tool, `{"command":"cat /tmp/scan.progress"}`).IsError {
+			t.Fatalf("poll %d refused although its result changed", i)
+		}
+	}
+}
+
+func TestRepeatGuardSameArgsOnDifferentToolsAreDistinct(t *testing.T) {
+	g := newGuard()
+	a := g.wrap(&fakeTool{name: "list_assets", out: constOut()})
+	b := g.wrap(&fakeTool{name: "list_tasks", out: constOut()})
+	in := `{"x":1}`
+	for i := 0; i < repeatGuardLimit-1; i++ {
+		call(t, a, in)
+		call(t, b, in)
+	}
+	if call(t, a, in).IsError || call(t, b, in).IsError {
+		t.Fatal("tools counted together, want a separate count per tool")
+	}
+	if !call(t, a, in).IsError {
+		t.Fatal("list_assets past its limit executed, want refused")
+	}
+}
+
+func TestRepeatGuardCanonicalisesArgumentOrder(t *testing.T) {
+	ft := &fakeTool{name: "list_assets", out: constOut()}
+	tool := newGuard().wrap(ft)
+	call(t, tool, `{"a":1,"b":2}`)
+	call(t, tool, `{"b":2,"a":1}`)
+	call(t, tool, `{ "a" : 1, "b" : 2 }`)
+	if !call(t, tool, `{"b":2,"a":1}`).IsError {
+		t.Fatal("reordered identical arguments were not recognised as a repeat")
+	}
+}
+
+func TestRepeatGuardSeparateRunsAreIndependent(t *testing.T) {
+	in := `{"dsl":"ip==1.1.1.1"}`
+	first := newGuard().wrap(&fakeTool{name: "list_assets", out: constOut()})
+	for i := 0; i < repeatGuardLimit; i++ {
+		call(t, first, in)
+	}
+	second := newGuard().wrap(&fakeTool{name: "list_assets", out: constOut()})
+	if call(t, second, in).IsError {
+		t.Fatal("a new agent run inherited another run's history")
+	}
+}
