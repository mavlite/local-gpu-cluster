# ARTEX (LXC 158 artex-redteam) environment — copy to /root/artex-global/.env,
# fill in the two secrets, chmod 600. NEVER commit the real .env.
#
#   cp env.example /root/artex-global/.env && chmod 600 /root/artex-global/.env
#
POSTGRES_USER=artex
POSTGRES_DB=artex
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=__GENERATE_RANDOM__

# LLM = the V620 router's abliterated red-team profile (OpenAI-compatible).
# The model only answers while that profile is deliberately loaded on the router
# (swap-chat-model.sh qwen3.8-redteam, 3-slot/redteam mode). Do not leave it live.
ARTEX_LLM_PROVIDER=openai
ARTEX_LLM_BASE_URL=http://192.168.6.153:8000/v1
ARTEX_LLM_MODEL=qwen3.8-redteam
ARTEX_LLM_STREAM=true
# The router API key — reuse the one in LXC 157's opencode.json
# (provider.router.options.apiKey). Keep it out of git.
OPENAI_API_KEY=__ROUTER_API_KEY__

# Server-side default language.
ARTEX_LANG=en

# 0.0.0.0 publishes the UI on the LXC's LAN IP (http://192.168.6.158:8787);
# 127.0.0.1 keeps it loopback-only (reach via SSH tunnel). The mitmproxy port
# 8788 stays bound to 127.0.0.1 regardless.
ARTEX_BIND=0.0.0.0

# Leave blank to have ARTEX print a one-time setup token in the logs
# (docker logs artex-global-artex-1) for first-run admin-password creation at /setup.
ARTEX_ADMIN_PASSWORD=
ARTEX_SETUP_TOKEN=
