{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcfspec.invalid/inventory/v1",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "instance",
    "dns",
    "ntp",
    "networks",
    "nsx",
    "storage",
    "appliances",
    "hosts",
    "credentials"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "vcfspec/v1"
    },
    "kind": {
      "const": "LabInventory"
    },
    "instance": {
      "type": "object",
      "required": [
        "name",
        "sddcId",
        "vcfVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sddcId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "vcfVersion": {
          "type": "string"
        }
      }
    },
    "dns": {
      "type": "object",
      "required": [
        "subdomain",
        "nameservers"
      ],
      "additionalProperties": false,
      "properties": {
        "subdomain": {
          "type": "string",
          "minLength": 1
        },
        "nameservers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ntp": {
      "type": "object",
      "required": [
        "servers"
      ],
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networks": {
      "type": "object",
      "required": [
        "management",
        "vmotion",
        "vsan"
      ],
      "propertyNames": {
        "enum": [
          "management",
          "vmotion",
          "vsan"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/network"
      }
    },
    "nsx": {
      "type": "object",
      "required": [
        "vipFqdn",
        "managers",
        "transportVlanId",
        "tepPool"
      ],
      "additionalProperties": false,
      "properties": {
        "vipFqdn": {
          "type": "string",
          "minLength": 1
        },
        "managers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shortname"
          }
        },
        "size": {
          "enum": [
            "medium",
            "large",
            "xlarge"
          ]
        },
        "transportVlanId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4094
        },
        "fabricMtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9190
        },
        "tepPool": {
          "type": "object",
          "required": [
            "name",
            "cidr",
            "gateway",
            "ranges"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-_]+$"
            },
            "cidr": {
              "type": "string"
            },
            "gateway": {
              "type": "string"
            },
            "ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false,
                "properties": {
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "VSAN_ESA",
            "VSAN_OSA",
            "NFS",
            "VMFS_FC"
          ]
        },
        "datastoreName": {
          "type": "string",
          "maxLength": 80
        },
        "failuresToTolerate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "appliances": {
      "type": "object",
      "required": [
        "vcenter",
        "sddcManager",
        "vsp"
      ],
      "additionalProperties": false,
      "properties": {
        "vcenter": {
          "type": "object",
          "required": [
            "hostname"
          ],
          "additionalProperties": false,
          "properties": {
            "hostname": {
              "$ref": "#/$defs/shortname"
            },
            "size": {
              "enum": [
                "tiny",
                "small",
                "medium",
                "large",
                "xlarge"
              ]
            },
            "ssoDomain": {
              "type": "string"
            }
          }
        },
        "sddcManager": {
          "type": "object",
          "required": [
            "hostname"
          ],
          "additionalProperties": false,
          "properties": {
            "hostname": {
              "$ref": "#/$defs/shortname"
            }
          }
        },
        "vsp": {
          "type": "object",
          "required": [
            "platformFqdn",
            "instanceFqdn",
            "poolStart",
            "poolEnd"
          ],
          "additionalProperties": false,
          "properties": {
            "platformFqdn": {
              "type": "string",
              "minLength": 1
            },
            "instanceFqdn": {
              "type": "string",
              "minLength": 1
            },
            "poolStart": {
              "type": "string"
            },
            "poolEnd": {
              "type": "string"
            },
            "internalCidr": {
              "enum": [
                "198.18.0.0/15",
                "240.0.0.0/15",
                "250.0.0.0/15"
              ]
            }
          }
        }
      }
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "name",
          "mgmtIp",
          "vmnics",
          "hardware"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/shortname"
          },
          "mgmtIp": {
            "type": "string"
          },
          "vmnics": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "hardware": {
            "type": "object",
            "required": [
              "cores",
              "ramGb"
            ],
            "additionalProperties": false,
            "properties": {
              "cores": {
                "type": "integer",
                "minimum": 1
              },
              "ramGb": {
                "type": "number",
                "minimum": 1
              },
              "vsanDeviceTb": {
                "type": "number",
                "minimum": 0
              },
              "memoryTieringGb": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "provisioningMac": {
            "description": "MAC of the NIC that UEFI HTTP boots. Per-MAC config is the provisioning mechanism, so this is how a booting host finds its own kickstart.",
            "type": "string",
            "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$"
          },
          "bootDisk": {
            "description": "Kickstart disk selector for the ESX install target. Passed through uninterpreted. Name the device explicitly rather than relying on first-disk ordering: this lab has a 4 TB vSAN device that an install must never claim.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "minProperties": 1
    },
    "provisioning": {
      "description": "Properties of the provisioning environment rather than of any one host.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootServerUrl"
      ],
      "properties": {
        "bootServerUrl": {
          "description": "Base URL the booting host fetches its kickstart from. The ESX installer does not validate TLS for ks=https, so the provisioning VLAN is the trust boundary, not the transport.",
          "type": "string",
          "pattern": "^https?://"
        },
        "esxVersion": {
          "description": "ESX build to provision. Defaults to the VCF 9.1.1 commissioning target.",
          "type": "string",
          "default": "9.1.1.0"
        },
        "installerPayloadUrl": {
          "description": "URL of the directory holding the unpacked ESX ISO contents, which boot.cfg's prefix= must point at. This is not the kickstart directory. Defaults to <bootServerUrl>/esx-<esxVersion>.",
          "type": "string",
          "pattern": "^https?://"
        }
      }
    }
  },
  "$defs": {
    "shortname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$"
    },
    "network": {
      "type": "object",
      "required": [
        "vlan",
        "subnet",
        "gateway",
        "mtu"
      ],
      "additionalProperties": false,
      "properties": {
        "vlan": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4094
        },
        "subnet": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9190
        },
        "pool": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
